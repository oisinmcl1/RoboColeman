// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workout {
  id      String    @id @default(cuid())
  date    DateTime  @default(now())
  note    String?
  setLogs SetLog[]
  // Optional: a Workout may be performed against a Plan. Deleting the Plan
  // sets this to null rather than deleting the logged Workout (see SetNull).
  planId  String?
  plan    Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
}

model Plan {
  id        String     @id @default(cuid())
  name      String
  note      String?
  createdAt DateTime   @default(now())
  items     PlanItem[]
  workouts  Workout[]
}

model PlanItem {
  id            String  @id @default(cuid())
  planId        String
  plan          Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  // String key into the in-code BASELINE catalog (e.g. 'squat'), not a DB relation.
  exerciseId    String
  order         Int
  targetSets    Int?
  targetRepMin  Int?
  targetRepMax  Int?
  targetWeightKg Float?

  @@index([planId])
}

model SetLog {
  id         String  @id @default(cuid())
  workoutId  String
  workout    Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  // String key into the in-code BASELINE catalog (e.g. 'squat'), not a DB relation.
  exerciseId String
  order      Int
  weightKg   Float?
  reps       Int?
  rpe        Float?

  @@index([workoutId])
  @@index([exerciseId])
}

model Exercise {
  // The stable string key from the in-code BASELINE catalog (e.g. 'squat').
  // NOT a cuid — these ids match the baseline so engine logic and any existing
  // exerciseId references (PlanItem, SetLog) line up.
  id          String   @id
  name        String
  type        String
  scope       String
  repRangeMin Int
  repRangeMax Int
  // The increment discriminated-union object, stored whole as JSON. Its shape
  // varies by `kind`, so a single typed column can't capture it — JSON keeps it
  // intact and Zod re-validates it on read.
  increment   Json
  baselineKg  Float
  unit        String
  parked      Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
}

model RoboMemory {
  id        String   @id @default(cuid())
  content   String
  category  String?
  createdAt DateTime @default(now())
}
